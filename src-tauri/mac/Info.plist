<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Says the app can open folders, which is what lets it be chosen as the
	     default file manager (Settings > General). "Alternate" means it never
	     takes folders over by itself: Finder stays the default until asked. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
				<string>public.volume</string>
			</array>
		</dict>
	</array>
	<!-- What macOS shows when the person opens one of these folders themselves. The app asks for Full Disk Access
	     once instead (Settings > Permissions), which stops these prompts for good. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>FAST File Explorer shows the files in this folder when you open it.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>FAST File Explorer shows the files in this folder when you open it.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>FAST File Explorer shows the files in this folder when you open it.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>FAST File Explorer shows the files on this drive when you open it.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>FAST File Explorer shows the files on this network drive when you open it.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>FAST File Explorer shows the files in your Music folder when you open it.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FAST File Explorer shows the files in your Pictures folder when you open it.</string>
</dict>
</plist>
